# NebulaCompute Environment Configuration
# ========================================
# Copy this file to .env and fill in the values

# ============ Core Settings ============
NEBULA_SECRET_KEY=your-secret-key-here
NEBULA_MASTER_HOST=0.0.0.0
NEBULA_MASTER_PORT=8080
NEBULA_WORKER_PORT=8081

# ============ Database ============
NEBULA_DB_PATH=/data/cluster.db
NEBULA_STATE_DIR=/data/state

# ============ Storage (MinIO/S3) ============
MINIO_ROOT_USER=nebula
MINIO_ROOT_PASSWORD=nebula123
MINIO_ENDPOINT=localhost:9000

# ============ AI Providers (Optional) ============
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ============ Redis (Optional) ============
REDIS_URL=redis://localhost:6379

# ============ PostgreSQL (Optional) ============
POSTGRES_URL=postgresql://user:password@localhost:5432/nebula

# ============ Logging ============
LOG_LEVEL=INFO
